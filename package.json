{
  "name": "model-catalog",
  "version": "1.0.0",
  "description": "Public model catalog for Swiss. One entry per model, describing **how that model should be served** — and nothing about where.",
  "homepage": "https://github.com/modelsphere/model-catalog#readme",
  "bugs": {
    "url": "https://github.com/modelsphere/model-catalog/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modelsphere/model-catalog.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "tools:install": "node hack/install-helm-tools.js",
    "helm:build-crds": "node hack/build-crds.js",
    "validate": "npm run validate:schema && npm run validate:helm && npm run validate:images",
    "format": "prettier --write \"**/*.{js,cjs,mjs,ts,tsx,mts,css}\"",
    "format:check": "prettier --check \"**/*.{js,cjs,mjs,ts,tsx,mts,css}\"",
    "validate:schema": "node hack/validate-schema.js",
    "validate:helm": "node hack/validate-helm.js",
    "validate:images": "node hack/validate-images.js",
    "test": "node --test 'hack/lib/*.test.js' hack/validate-helm.test.js 'server/*.test.js' && npm run test:web",
    "test:helm:integration": "node --test hack/validate-helm.integration.test.js",
    "build:site": "vite build --config web/vite.config.mts --logLevel warn",
    "serve": "node server",
    "dev:site": "vite --config web/vite.config.mts",
    "preview:site": "vite preview --config web/vite.config.mts",
    "test:web": "tsc -p web && vitest run --config web/vite.config.mts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "html-validate": "^11.16.2",
    "husky": "^9.1.7",
    "ipaddr.js": "^2.5.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0"
  }
}
