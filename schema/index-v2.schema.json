{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swiss.catalog/schema/index-v2.schema.json",
  "title": "Swiss catalog index (v2)",
  "description": "index-v2.json: the v2 models (metadata.yaml catalog.swiss/v2) and their variant files, generated by the Pages build from models/, catalog.yaml and git history. v1 models stay in index.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "count",
    "models"
  ],
  "properties": {
    "apiVersion": {
      "const": "catalog.swiss/v2"
    },
    "site": {
      "$ref": "catalog.schema.json#/properties/site"
    },
    "repo": {
      "$ref": "catalog.schema.json#/properties/repo"
    },
    "raw": {
      "description": "Old revisions are fetched at <raw><commit>/<path>.",
      "$ref": "catalog.schema.json#/properties/raw"
    },
    "commit": {
      "description": "The last commit that changed models/ or catalog.yaml.",
      "$ref": "#/$defs/commit"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model"
      }
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "digest": {
      "description": "sha256 of the file's bytes.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "pattern": "^models/[a-z0-9][a-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "reports",
        "tuning",
        "variants"
      ],
      "properties": {
        "name": {
          "$ref": "metadata.schema.json#/properties/name"
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "series": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deprecated": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hf": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            },
            "sizeGiB": {
              "type": "number"
            }
          }
        },
        "quantization": {
          "type": "string"
        },
        "defaultVariant": {
          "description": "The first variant when absent.",
          "type": "string"
        },
        "reports": {
          "description": "Linkable reports at models/<name>/<report>.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tuning": {
          "description": "As in metadata.yaml, without the legacy version; report absent when not linkable.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "baseline",
              "optimized"
            ],
            "properties": {
              "baseline": {
                "type": "string"
              },
              "optimized": {
                "type": "string"
              },
              "uplift": {
                "type": "number"
              },
              "workloads": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "uplift"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "uplift": {
                      "type": "number"
                    }
                  }
                }
              },
              "report": {
                "type": "string"
              }
            }
          }
        },
        "variants": {
          "description": "One per variant file, by id.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/variant"
          }
        }
      }
    },
    "variant": {
      "description": "A variant without its values.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "path",
        "digest",
        "engine",
        "chart",
        "requires",
        "history",
        "releaseDate"
      ],
      "properties": {
        "id": {
          "$ref": "version.schema.json#/$defs/variant/properties/id"
        },
        "version": {
          "description": "The variant file's version.",
          "type": "string"
        },
        "releaseDate": {
          "type": "string",
          "format": "date"
        },
        "commit": {
          "description": "The last commit that changed the file; with path and digest, what a deploy pins. Absent when uncommitted.",
          "$ref": "#/$defs/commit"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "history": {
          "description": "Its history.json.",
          "$ref": "#/$defs/path"
        },
        "servedName": {
          "type": "string"
        },
        "engine": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "link": {
          "type": "string",
          "pattern": "^https?://"
        },
        "chart": {
          "$ref": "version.schema.json#/$defs/variant/properties/chart"
        },
        "image": {
          "$ref": "version.schema.json#/$defs/variant/properties/image"
        },
        "requires": {
          "$ref": "version.schema.json#/$defs/variant/properties/requires"
        },
        "deprecated": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "replaces": {
          "type": "string"
        }
      }
    }
  }
}
